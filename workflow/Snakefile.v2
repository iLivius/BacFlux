# BacFlux v2.0.0 — Unified bacterial whole-genome sequencing workflow.
#
# One Snakefile, four input modes. config["mode"] selects the pipeline:
#   illumina → Illumina paired-end short reads   (rules/illumina/*.smk)
#   nanopore → Oxford Nanopore long reads        (rules/nanopore/*.smk)
#   hybrid   → Illumina + ONT, ONT-first         (rules/hybrid/*.smk)
#   contigs  → pre-assembled genomes             (rules/contigs/*.smk)
# Shared downstream analysis (taxonomy → annotation → AMR → plasmids → phages →
# report) is identical for every mode and lives in rules/shared/*.smk.
#
# Run from the repository root:
#   snakemake --sdm conda --cores N --configfile config/config.yaml
# (--sdm is the modern alias for --software-deployment-method, replacing the
#  deprecated --use-conda flag.)

import glob
import os

print(r'''
________             _______________
___  __ )_____ _________  ____/__  /___  _____  __
__  __  |  __ `/  ___/_  /_   __  /_  / / /_  |/_/
_  /_/ // /_/ // /__ _  __/   _  / / /_/ /__>  <
/_____/ \__,_/ \___/ /_/      /_/  \__,_/ /_/|_|

BacFlux v2.0.0
Unified genomic analysis of bacterial genomes
Illumina · Nanopore · Hybrid · Pre-assembled contigs

Livio Antonielli, 2026
''')

# Default config, resolved relative to the launch directory — so run from the
# repository root (as the command above does). A user-supplied --configfile
# overrides this at launch and is the normal way to point at a custom config.
configfile: "config/config.yaml"

# 1) Foundation. 00_common.smk validates config["mode"], sets the working
#    directory, discovers samples, and defines every shared helper/constant —
#    including MODE and all_targets(), both used just below. It MUST be first:
#    the two include loops and rule all all depend on names it creates.
include: "rules/shared/00_common.smk"

# 2) The active mode's front-end rule modules (read QC, assembly, polishing).
#    A sorted glob preserves numeric order (10_, 20_, …). During early migration
#    the rules/<mode>/ directory may not exist yet — glob.glob then returns an
#    empty list, nothing is included, and the workflow still parses.
for _smk in sorted(glob.glob(os.path.join(workflow.basedir, "rules", MODE, "*.smk"))):
    include: _smk

# 3) Shared downstream modules (10_decontam … 80_mobilome) in numeric order.
#    Globbed (not hard-coded) so the skeleton parses before these files exist.
#    00_common is already included above; 90_report is included last (step 4) so
#    it sees every upstream rule's outputs — both are skipped here.
for _smk in sorted(glob.glob(os.path.join(workflow.basedir, "rules", "shared", "*.smk"))):
    if os.path.basename(_smk) in ("00_common.smk", "90_report.smk"):
        continue
    include: _smk

# 4) Report module last, once it exists.
_report_smk = os.path.join(workflow.basedir, "rules", "shared", "90_report.smk")
if os.path.exists(_report_smk):
    include: _report_smk


# Default target. all_targets() (from 00_common.smk) returns this mode's
# front-end leaves plus the shared downstream deliverables — or an empty list
# while the rule modules that would build them do not exist yet, so a dry run of
# the bare skeleton reports "Nothing to be done" instead of failing on targets
# no rule can produce.
rule all:
    input:
        all_targets()