# BacFlux v2.0.1 — Unified bacterial whole-genome sequencing workflow.
#
# One Snakefile, four input modes. config["mode"] selects the pipeline:
#   illumina → Illumina paired-end short reads   (rules/illumina/*.smk)
#   nanopore → Oxford Nanopore long reads        (rules/nanopore/*.smk)
#   hybrid   → Illumina + ONT, ONT-first         (rules/hybrid/*.smk)
#   contigs  → pre-assembled genomes             (rules/contigs/*.smk)
# Everything downstream of assembly is shared — one copy of each rule in
# rules/shared/*.smk, used by all four modes: decontamination → assembly QC →
# taxonomy → annotation → AMR → plasmids → phages → (mobilome) → report.
# Parentheses mark the one optional stage — the mobilome module runs only when
# config.mobilome.run is true (see rules/shared/80_mobilome.smk).
#
# Run from the repository root:
#   snakemake --sdm conda --cores N --configfile config/config.yaml
# (--sdm is the modern alias for --software-deployment-method, replacing the
#  deprecated --use-conda flag.)

import glob
import os
import sys

from snakemake.utils import min_version

# The oldest Snakemake BacFlux runs with, checked before any rule file is read.
# On an older version min_version stops the run at once with a message naming
# the version it needs. Keep this number the same as the README badge and the
# installation page.
min_version("9.14.6")

# Keep a user's personal pip packages out of every conda environment.
#
# Python adds ~/.local/lib/python3.X/site-packages to its import path by default,
# for whichever X it is. A tool running in a conda env with Python 3.13 therefore
# also sees anything the user once `pip install --user`-ed for 3.13 on the host,
# and a stray or older package there can shadow the env's own copy. That is a
# classic "works on my machine" failure: the environment files are identical, the
# extra package is invisible in them, and only one person hits it.
#
# PYTHONNOUSERSITE=1 tells Python to skip that directory. Setting it here, in the
# process that launches every job, means every rule inherits it without touching
# the rules themselves. Conda activation does not unset it.
os.environ["PYTHONNOUSERSITE"] = "1"

# Write BacFlux's own messages at the moment they are printed.
#
# The banner below, and the notes the rule files print while Snakemake reads
# them (the mode, the phage caller and its licence, the mobilome settings), go to
# standard output. Snakemake's own messages go to standard error. When a run's
# output is saved to a file, for example piped through `tee` or written to a
# cluster job's log, Python holds standard output back and writes it only when
# its buffer is full or the program ends, so those notes would land at the END of
# the log, after every job. Line buffering writes each line as it is printed, so
# the log reads in the order things happened. The hasattr check skips this in the
# rare case where standard output has been replaced by something that cannot do it.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(line_buffering=True)

print(r'''
________             _______________
___  __ )_____ _________  ____/__  /___  _____  __
__  __  |  __ `/  ___/_  /_   __  /_  / / /_  |/_/
_  /_/ // /_/ // /__ _  __/   _  / / /_/ /__>  <
/_____/ \__,_/ \___/ /_/      /_/  \__,_/ /_/|_|

BacFlux v2.0.1
Unified genomic analysis of bacterial genomes
Illumina · Nanopore · Hybrid · Pre-assembled contigs

Livio Antonielli, 2026
''')

# NO default `configfile:` here — this is deliberate.
#
# Snakemake MERGES a hard-coded `configfile:` with whatever --configfile is given
# on the command line; it does not replace it. A default pointing at the shipped
# config/config.yaml would therefore quietly fill in every key the user's own copy
# happens to omit — with the example file's own empty-string placeholders
# (`bakta_db: ""` and friends) or its default download links — and the run would
# carry on against a path that does not exist instead of stopping. That defeats
# the guarantee 00_common.smk documents: a missing key must stop the run, not
# default to something wrong. So the config is REQUIRED on the command line, and
# 00_common.smk exits with a clear message when none is supplied:
#
#   snakemake --sdm conda --cores N --configfile config/config.yaml
#
# `--cores N` is the ONE knob for CPU. Every cpu-bound rule declares Snakemake's
# built-in `threads:`, so --cores enforces the ceiling on its own. Do NOT also
# pass `--jobs`/`-j`: for a local run it is an alias for --cores, and combining
# the two can silently let rules oversubscribe the machine.

# 1) Foundation. 00_common.smk validates config["mode"], resolves the output root
#    and the database paths, discovers the samples for the ACTIVE mode only, and
#    defines every shared constant and helper — including MODE and all_targets(),
#    both used just below. It MUST come first: the two include loops and rule all
#    can only resolve names it has already created.
#    It deliberately does NOT set a working directory. v1 used Snakemake's
#    `workdir:`; v2 builds every path off an absolute OUT instead, so the process
#    never leaves the launch directory and a relative input path means what a user
#    expects it to mean (reasoning in 00_common.smk section 2).
include: "rules/shared/00_common.smk"

# 2) The active mode's front-end rule modules (read QC, assembly, polishing).
#    A sorted glob preserves numeric order (10_, 20_, …). During early migration
#    the rules/<mode>/ directory may not exist yet — glob.glob then returns an
#    empty list, nothing is included, and the workflow still parses.
#    The other half of that safety is in 00_common.smk: _rule_modules_present()
#    globs this same directory, and all_targets() returns nothing while it is
#    empty (see rule all at the bottom).
for _smk in sorted(glob.glob(os.path.join(workflow.basedir, "rules", MODE, "*.smk"))):
    include: _smk

# 3) Shared downstream modules (10_decontam … 80_mobilome) in numeric order.
#    Globbed (not hard-coded) so the skeleton parses before these files exist.
#    00_common is already included above; 90_report is included last (step 4) so
#    it sees every upstream rule's outputs — both are skipped here.
#    Two files in rules/shared/ are long-read-only despite living here:
#    12_medaka_check and 15_replicons. They sit in shared/ because nanopore and
#    hybrid would otherwise hold byte-identical copies of them, and each wraps its
#    rules in a HAS_LONG_READS gate, so including them unconditionally defines
#    nothing at all in illumina and contigs mode.
for _smk in sorted(glob.glob(os.path.join(workflow.basedir, "rules", "shared", "*.smk"))):
    if os.path.basename(_smk) in ("00_common.smk", "90_report.smk"):
        continue
    include: _smk

# 4) Report module last. 90_report.smk gathers every QC artefact the run produced
#    into one MultiQC page, so it is included after everything that produces one.
#    The exists() guard is the same skeleton safety as the globs above.
_report_smk = os.path.join(workflow.basedir, "rules", "shared", "90_report.smk")
if os.path.exists(_report_smk):
    include: _report_smk


# Default target. all_targets() (from 00_common.smk) returns this mode's
# front-end leaves plus the shared downstream deliverables — or an empty list
# while the rule modules that would build them do not exist yet, so a dry run of
# the bare skeleton reports "Nothing to be done" instead of failing on targets
# no rule can produce.
rule all:
    input:
        all_targets()


# Optional target: fetch every database and model set this run would download,
# and nothing else. Name it right after `snakemake`, because --configfile and
# --sdm each take several values:
#
#   snakemake download_all --sdm conda --cores 4 --configfile <your config>
#
# The download rules are local rules, so on a cluster they run on the computer
# that runs Snakemake anyway. This target is for a run whose jobs have no
# internet at all, such as the whole run inside one batch job: run it first on a
# computer with internet, from the same folder, with the same config and the
# same --conda-prefix. download_targets() in 00_common.smk lists what it fetches
# and what it leaves out.
#
# Must stay below `rule all`: Snakemake runs the first rule of the Snakefile when
# no target is named, and that must be the whole workflow.
rule download_all:
    localrule: True
    input:
        download_targets()
